        "        \"25%\",\n",
        "        \"50%\",\n",
        "        \"75%\",\n",
        "        \"max\"\n",
        "    ]\n",
        "]\n",
        "\n",
        "estadisticas = estadisticas.rename(columns={\n",
        "    \"count\": \"N\",\n",
        "    \"mean\": \"Media\",\n",
        "    \"std\": \"Desv. estándar\",\n",
        "    \"min\": \"Mínimo\",\n",
        "    \"25%\": \"Q1\",\n",
        "    \"50%\": \"Mediana\",\n",
        "    \"75%\": \"Q3\",\n",
        "    \"max\": \"Máximo\"\n",
        "})\n",
        "\n",
        "display(estadisticas)"
