      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "===== MÉTRICAS GRADIENT BOOSTING MEJORADO =====\n",
            "Accuracy : 0.9113\n",
            "Precision: 0.9183\n",
            "Recall   : 0.9113\n",
            "F1-score : 0.9121\n"
          ]
        }
      ],
      "source": [
        "# Métricas del modelo mejorado\n",
        "\n",
        "accuracy_mejorado = accuracy_score(y_test, y_pred_mejorado)\n",
        "\n",
        "precision_mejorado = precision_score(\n",
        "    y_test,\n",
        "    y_pred_mejorado,\n",
        "    average=\"weighted\"\n",
        ")\n",
        "\n",
        "recall_mejorado = recall_score(\n",
        "    y_test,\n",
        "    y_pred_mejorado,\n",
        "    average=\"weighted\"\n",
        ")\n",
        "\n",
        "f1_mejorado = f1_score(\n",
        "    y_test,\n",
        "    y_pred_mejorado,\n",
        "    average=\"weighted\"\n",
        ")\n",
        "\n",
        "print(\"===== MÉTRICAS GRADIENT BOOSTING MEJORADO =====\")\n",
        "print(f\"Accuracy : {accuracy_mejorado:.4f}\")\n",
        "print(f\"Precision: {precision_mejorado:.4f}\")\n",
        "print(f\"Recall   : {recall_mejorado:.4f}\")\n",
        "print(f\"F1-score : {f1_mejorado:.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Revisar específicamente Rojo"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 182,
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "===== REPORTE DE CLASIFICACIÓN =====\n",
            "              precision    recall  f1-score   support\n",
            "\n",
            "    Amarillo       0.98      0.93      0.95       227\n",
            "        Rojo       0.96      0.85      0.90       218\n",
            "       Verde       0.83      0.95      0.89       254\n",
            "\n",
