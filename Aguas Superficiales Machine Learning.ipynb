        "faltantes = pd.DataFrame({\n",
        "    \"Valores faltantes\": df.isna().sum(),\n",
        "    \"Porcentaje\": df.isna().mean() * 100\n",
        "})\n",
        "\n",
        "faltantes = faltantes[faltantes[\"Valores faltantes\"] > 0]\n",
